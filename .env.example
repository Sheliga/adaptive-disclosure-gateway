# Example environment for the Adaptive Disclosure Gateway.
#
# Copy to `.env` (git-ignored) or export these in your shell. PLACEHOLDER
# VALUES ONLY -- never commit a real credential to this repository.

# --- Provider selection (T22 / issue #30) ------------------------------------
#
# The default is the deterministic, offline FakeProvider. Leave ADG_PROVIDER
# unset for TDD, CI, offline development and every reproducible regression
# run. Set it to `anthropic` only for a deliberate real-provider batch.
#
#   fake       (default) deterministic, offline, no credential, no cost
#   anthropic  real Anthropic Messages API call; requires the `anthropic`
#              optional extra (`pip install -e ".[anthropic]"`) and a key
#
# There is no fallback: with ADG_PROVIDER=anthropic and no credential, a
# call fails closed rather than quietly reverting to FakeProvider. Any
# OTHER non-empty value (e.g. a typo like "anthrpic") also fails closed --
# ProviderConfigurationError at configuration time -- rather than silently
# defaulting to FakeProvider.
# ADG_PROVIDER=anthropic

# The API credential. Read from the environment only -- it never appears in
# code, a config object, an artifact, an audit record, telemetry or a log.
# ANTHROPIC_API_KEY=sk-ant-REPLACE-ME

# --- Real-provider configuration (all optional; defaults shown) ---------------
#
# Exact model id, never date-suffixed. Must be one this adapter version has
# validated (currently only claude-opus-5, the default) -- any other id
# raises ProviderConfigurationError at configuration time.
# ADG_ANTHROPIC_MODEL_ID=claude-opus-5
#
# Maximum output tokens for one call.
# ADG_ANTHROPIC_MAX_OUTPUT_TOKENS=16000
#
# Thinking depth: low | medium | high | xhigh | max
# ADG_ANTHROPIC_EFFORT=high
#
# Thinking mode: adaptive | disabled. `disabled` is rejected by the API at
# effort xhigh/max, and the config object refuses that combination locally.
# ADG_ANTHROPIC_THINKING=adaptive
#
# Native transport timeout in seconds, configured on the SDK client itself.
# invoke_provider's caller-side deadline is derived from this automatically
# (native timeout + a fixed grace) so it always exceeds it -- see
# docs/provider-configuration.md's "Timeout and cancellation" section.
# ADG_ANTHROPIC_TIMEOUT_SECONDS=60
#
# FORBIDDEN: a base_url override is not supported by this adapter -- setting
# this raises ProviderConfigurationError. Two batches could both report an
# override without proving they hit the same backend, and a gateway/proxy
# would introduce a new, unrecorded experimental variable.
# ADG_ANTHROPIC_BASE_URL=
#
# provider_class is NOT configurable here. AnthropicProvider is invariably
# "external_llm" -- a fixed fact about this adapter (it calls Anthropic's
# real, official external endpoint), never a value the environment can pick.
# It must match GovernanceContext.provider_class the cases in a batch
# declare, or invoke_provider refuses the call before it is made; an
# internal_llm context always mismatches this adapter. See
# docs/provider-configuration.md.
#
# The *name* of the variable holding the credential -- not the credential.
# ADG_ANTHROPIC_API_KEY_ENV_VAR=ANTHROPIC_API_KEY

# --- Opt-in integration tests -------------------------------------------------
#
# One live synthetic provider call, skipped unless BOTH this and a
# credential are set. Costs money; never run against a corpus.
# ADG_RUN_ANTHROPIC_INTEGRATION=1
#
# Real Docling conversion (T12), skipped by default.
# ADG_RUN_DOCLING_INTEGRATION=1

# --- Demo application (see application/settings.py) --------------------------
# ADG_POLICY_DIR=
# ADG_EXAMPLES_DIR=
# ADG_DEFAULT_DOMAIN=hr
# ADG_DEFAULT_PURPOSE=team_summary
# ADG_DEFAULT_POLICY_VERSION=hr-v1
# ADG_DEFAULT_REQUESTER_ROLE=hr_analyst
# ADG_DEFAULT_SESSION_ID=demo-session
# ADG_ALLOWED_ORIGINS=
#
# The domain/purpose/policy defaults above apply to pasted text and prepared
# examples. An uploaded document (POST /documents/*) selects its governance
# explicitly through a server-side preset instead -- see
# application/presets.py and docs/advisor-demo.md.
#
# HTTP request-body ceiling, enforced before any body parser runs. Defaults
# to 8 MiB, deliberately below ingestion's own 10 MiB limit.
# ADG_MAX_UPLOAD_BYTES=8388608
#
# Key material signing the preview confirmation that binds one
# POST /documents/execute to the POST /documents/preview a reviewer approved
# (see application/preview_confirmation.py). Server-side only: it is never
# sent to the browser, never logged and never part of any response.
#
# REQUIRED whenever ADG_PROVIDER selects a provider outside the trust
# boundary -- that deployment refuses to start without it, because a
# per-process key cannot prove across workers or restarts which preview
# authorised a call. With the deterministic FakeProvider it is optional:
# per-process key material is generated instead, which still enforces
# confirmation in full and only gives up durability.
#
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# At least 32 bytes. Never commit a real value.
# ADG_PREVIEW_CONFIRMATION_SECRET=
